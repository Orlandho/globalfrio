# Copiar a .env. Asignar dos claves distintas y fuertes.
# DB_CLAVE: 12-128 caracteres: letras, números y símbolos _!@%+=.- (sin comillas, espacios ni $).
# MSSQL_SA_PASSWORD: política de complejidad SQL Server, al menos 12 caracteres recomendados.
MSSQL_SA_PASSWORD=
DB_CLAVE=
SQLSERVER_PORT=1433
BACKEND_PORT=8080
FRONTEND_PORT=4200
